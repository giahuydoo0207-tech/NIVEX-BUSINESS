PORT=8080
# 127.0.0.1 locally; the Docker image defaults to 0.0.0.0 for Railway/Render/Fly.
SERVER_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:postgresql://localhost:5433/nova
DATABASE_USER=nova
DATABASE_PASSWORD=nova_dev_only
# Server-side only. Same value as the web proxy's NOVA_DEMO_API_KEY. Never put it in the APK.
NOVA_DEMO_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DEMO_RECIPIENT=
# Informational: the verified mint is pinned in DevnetRpc.MINT (see DEVNET-DEMO.md).
SOLANA_USDC_MINT=BRjpCHtyQLNCo8gqRUr8jtdAj5AjPYQaoqbvcZiHok1k
NOVA_PAYMENT_FINALIZER_ENABLED=true
