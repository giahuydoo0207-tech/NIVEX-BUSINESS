NEXT_PUBLIC_APP_MODE=demo
DATABASE_URL=postgresql://nova:nova_dev_only@localhost:5433/nova
SESSION_SECRET=replace-with-a-long-random-value

# Live backend mode. NEXT_PUBLIC_* is baked in at build time, so set these in
# Vercel (Production) BEFORE building. .env.development.local is ignored by
# `next build`/`next start`, which then silently fall back to demo fixtures.
DEVNET_DEMO_ENABLED=true
NEXT_PUBLIC_PAYMENT_MODE=devnet
NOVA_API_URL=https://<backend-public-url>
# Server-side only (never NEXT_PUBLIC_); same value as the backend.
NOVA_DEMO_API_KEY=
